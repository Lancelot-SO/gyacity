# SMTP credentials — fill these in for your provider, then copy this
# file to `.env` (which is gitignored). Do NOT put real secrets here.
# For Gmail: use an App Password (not your main password)
# For Hostinger / Brevo / Mailgun / other: use their SMTP host + credentials

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false          # set to true only for port 465
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password

# Where to deliver contact form submissions
MAIL_TO=hello@gyacityconstruction.com

# The "From" label shown in the inbox
MAIL_FROM=Gyacity Contact Form

# Which origin is allowed to POST here (your live site URL)
# Use * during development, lock it down in production
ALLOWED_ORIGIN=https://gyacityconstruction.com

# Port this server listens on
PORT=3001
